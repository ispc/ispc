static inline unmasked constexpr uniform __m128i _mm_srl_epi64(uniform __m128i _A, uniform __m128i _Count) {
    const uniform uint64<2> lanes = @llvm.ispc.bitcast(_A.m128i_i32, (uniform uint64<2>)0);
    const uniform uint64<2> count = @llvm.ispc.bitcast(_Count.m128i_i32, (uniform uint64<2>)0);
    // Retain the four-lane comparison for the out-of-range count path.
    const uniform uint64<4> packed = {lanes[0], lanes[1], 0, 0};
    const uniform uint64<4> shifted = count[0] > 63 ? (packed ? 0xFFFFFFFFFFFFFFFF : 0) : packed >> count[0];
    const uniform uint64<2> result = {shifted[0], shifted[1]};
    return __mm_from_short_vector<uint64, 2>(result);
}

/*
 * Integer, comparisons
 */

static inline unmasked constexpr uniform __m128i _mm_cmpeq_epi8(uniform __m128i _A, uniform __m128i _B) {
    const uniform int8<16> a = __mm_to_short_vector<int8, 16>(_A);
    const uniform int8<16> b = __mm_to_short_vector<int8, 16>(_B);
    const uniform int8<16> lanes = -(uniform int8<16>)(a == b);
    return __mm_from_short_vector<int8, 16>(lanes);
}

static inline unmasked constexpr uniform __m128i _mm_cmpeq_epi16(uniform __m128i _A, uniform __m128i _B) {
