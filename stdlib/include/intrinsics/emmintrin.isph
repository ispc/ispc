static inline unmasked constexpr uniform __m128i _mm_unpacklo_epi8(uniform __m128i _A, uniform __m128i _B) {
    const uniform int8<16> a = __mm_to_short_vector<int8, 16>(_A);
    const uniform int8<16> b = __mm_to_short_vector<int8, 16>(_B);
    const uniform int8<16> lanes = {a[0], b[0], a[1], b[1], a[2], b[2], a[3], b[3],
                                    a[4], b[4], a[5], b[5], a[6], b[6], a[7], b[7]};
