static inline unmasked constexpr uniform __m128i _mm_and_si128(uniform __m128i _A, uniform __m128i _B) {
    uniform __m128i result = {_A.m128i_i32 & _B.m128i_i32};
    return result;
}

static inline unmasked constexpr uniform __m128i _mm_andnot_si128(uniform __m128i _A, uniform __m128i _B) {
    uniform __m128i result = {~_A.m128i_i32 & _B.m128i_i32};
    return result;
}

static inline unmasked constexpr uniform __m128i _mm_or_si128(uniform __m128i _A, uniform __m128i _B) {
    uniform __m128i result = {_A.m128i_i32 | _B.m128i_i32};
    return result;
}

static inline unmasked constexpr uniform __m128i _mm_xor_si128(uniform __m128i _A, uniform __m128i _B) {
    uniform __m128i result = {_A.m128i_i32 ^ _B.m128i_i32};
    return result;
}

/*
 * Integer, shifts
 */

static inline unmasked constexpr uniform __m128i _mm_slli_si128(uniform __m128i _A, uniform int _Imm) {
    const uniform uint32 count = (uniform uint32)_Imm;
    if (count == 0) {
        return _A;
    }
    if (count >= 16) {
        uniform __m128i zero = {{0, 0, 0, 0}};
        return zero;
    }
    // SSE byte order places the least significant byte first in each 64-bit lane.
    const uniform uint64<2> lanes = @llvm.ispc.bitcast(_A.m128i_i32, (uniform uint64<2>)0);
    const uniform uint32 bits = (count & 7) * 8;
    uniform uint64<2> across = {0, lanes[0]};
    if (count >= 8) {
        across = across << bits;
    } else {
        across = (lanes << bits) | (across >> (64 - bits));
    }
    return __mm_from_short_vector<uint64, 2>(across);
}

// Keep the immediate form recognizable as a single packed byte shift.
template <int Imm> inline unmasked constexpr uniform __m128i _mm_slli_si128(uniform __m128i _A) {
    constexpr uniform int shift = (uniform uint32)Imm < 16 ? Imm : 16;
    const uniform uint8<16> source = @llvm.ispc.bitcast(_A.m128i_i32, (uniform uint8<16>)0);
    const uniform uint8 zero = 0;
    const uniform uint8<16> result = {
        0 >= shift ? source[(0 - shift) & 15] : zero,   1 >= shift ? source[(1 - shift) & 15] : zero,
        2 >= shift ? source[(2 - shift) & 15] : zero,   3 >= shift ? source[(3 - shift) & 15] : zero,
        4 >= shift ? source[(4 - shift) & 15] : zero,   5 >= shift ? source[(5 - shift) & 15] : zero,
        6 >= shift ? source[(6 - shift) & 15] : zero,   7 >= shift ? source[(7 - shift) & 15] : zero,
        8 >= shift ? source[(8 - shift) & 15] : zero,   9 >= shift ? source[(9 - shift) & 15] : zero,
        10 >= shift ? source[(10 - shift) & 15] : zero, 11 >= shift ? source[(11 - shift) & 15] : zero,
        12 >= shift ? source[(12 - shift) & 15] : zero, 13 >= shift ? source[(13 - shift) & 15] : zero,
        14 >= shift ? source[(14 - shift) & 15] : zero, 15 >= shift ? source[(15 - shift) & 15] : zero};
    return __mm_from_short_vector<uint8, 16>(result);
}

#define _mm_bslli_si128 _mm_slli_si128

// Keep the shift as a vector operation so the backend can select a packed instruction.
template <typename T, int LaneCount, bool Left>
static inline unmasked constexpr uniform __m128i __mm_shift_packed(uniform __m128i value, uniform int amount) {
    const uniform uint32 count = (uniform uint32)amount;
    constexpr uniform uint32 width = sizeof(uniform T) * 8;
    constexpr uniform bool signed_lanes = (uniform T)-1 < 0;
    uniform T<LaneCount> packed = @llvm.ispc.bitcast(value.m128i_i32, (uniform T<LaneCount>)0);
    if (Left || !signed_lanes) {
        if (count >= width) {
            uniform __m128i zero = {{0, 0, 0, 0}};
            return zero;
        }
        if (Left) {
            packed = packed << count;
        } else {
            packed = packed >> count;
        }
    } else {
        const uniform uint32 shift = count < width ? count : width - 1;
        packed = packed >> shift;
    }
    return __mm_from_short_vector<T, LaneCount>(packed);
}

static inline unmasked constexpr uniform __m128i _mm_slli_epi16(uniform __m128i _A, uniform int _Count) {
    return __mm_shift_packed<uint16, 8, true>(_A, _Count);
}

template <int Count> inline unmasked constexpr uniform __m128i _mm_slli_epi16(uniform __m128i _A) {
    return _mm_slli_epi16(_A, Count);
}

static inline unmasked constexpr uniform __m128i _mm_sll_epi16(uniform __m128i _A, uniform __m128i _Count) {
    const uniform uint16<8> packed = @llvm.ispc.bitcast(_A.m128i_i32, (uniform uint16<8>)0);
    const uniform uint64<2> count = @llvm.ispc.bitcast(_Count.m128i_i32, (uniform uint64<2>)0);
    const uniform uint16<8> result = count[0] > 15 ? 0 : packed << count[0];
    return __mm_from_short_vector<uint16, 8>(result);
}

static inline unmasked constexpr uniform __m128i _mm_slli_epi32(uniform __m128i _A, uniform int _Count) {
    return __mm_shift_packed<uint32, 4, true>(_A, _Count);
}

template <int Count> inline unmasked constexpr uniform __m128i _mm_slli_epi32(uniform __m128i _A) {
    return _mm_slli_epi32(_A, Count);
}

static inline unmasked constexpr uniform __m128i _mm_sll_epi32(uniform __m128i _A, uniform __m128i _Count) {
    const uniform uint32<4> packed = @llvm.ispc.bitcast(_A.m128i_i32, (uniform uint32<4>)0);
    const uniform uint64<2> count = @llvm.ispc.bitcast(_Count.m128i_i32, (uniform uint64<2>)0);
    const uniform uint32<4> result = count[0] > 31 ? 0 : packed << count[0];
    return __mm_from_short_vector<uint32, 4>(result);
}

static inline unmasked constexpr uniform __m128i _mm_slli_epi64(uniform __m128i _A, uniform int _Count) {
    return __mm_shift_packed<uint64, 2, true>(_A, _Count);
}

template <int Count> inline unmasked constexpr uniform __m128i _mm_slli_epi64(uniform __m128i _A) {
    return _mm_slli_epi64(_A, Count);
}

static inline unmasked constexpr uniform __m128i _mm_sll_epi64(uniform __m128i _A, uniform __m128i _Count) {
    const uniform uint64<2> packed = @llvm.ispc.bitcast(_A.m128i_i32, (uniform uint64<2>)0);
    const uniform uint64<2> count = @llvm.ispc.bitcast(_Count.m128i_i32, (uniform uint64<2>)0);
    const uniform uint64<2> result = count[0] > 63 ? 0 : packed << count[0];
    return __mm_from_short_vector<uint64, 2>(result);
}

static inline unmasked constexpr uniform __m128i _mm_srai_epi16(uniform __m128i _A, uniform int _Count) {
    return __mm_shift_packed<int16, 8, false>(_A, _Count);
}

template <int Count> inline unmasked constexpr uniform __m128i _mm_srai_epi16(uniform __m128i _A) {
    return _mm_srai_epi16(_A, Count);
}

static inline unmasked constexpr uniform __m128i _mm_sra_epi16(uniform __m128i _A, uniform __m128i _Count) {
    const uniform int16<8> packed = @llvm.ispc.bitcast(_A.m128i_i32, (uniform int16<8>)0);
    const uniform uint64<2> count = @llvm.ispc.bitcast(_Count.m128i_i32, (uniform uint64<2>)0);
    const uniform int16<8> result = count[0] > 15 ? (packed ? 0xFFFF : 0) : packed >> count[0];
    return __mm_from_short_vector<int16, 8>(result);
}

static inline unmasked constexpr uniform __m128i _mm_srai_epi32(uniform __m128i _A, uniform int _Count) {
    return __mm_shift_packed<int32, 4, false>(_A, _Count);
}

template <int Count> inline unmasked constexpr uniform __m128i _mm_srai_epi32(uniform __m128i _A) {
    return _mm_srai_epi32(_A, Count);
}

static inline unmasked constexpr uniform __m128i _mm_sra_epi32(uniform __m128i _A, uniform __m128i _Count) {
    const uniform int32<4> packed = @llvm.ispc.bitcast(_A.m128i_i32, (uniform int32<4>)0);
    const uniform uint64<2> count = @llvm.ispc.bitcast(_Count.m128i_i32, (uniform uint64<2>)0);
    const uniform int32<4> result = count[0] > 31 ? (packed ? 0xFFFFFFFF : 0) : packed >> count[0];
    return __mm_from_short_vector<int32, 4>(result);
}

static inline unmasked constexpr uniform __m128i _mm_srli_si128(uniform __m128i _A, uniform int _Imm) {
    const uniform uint32 count = (uniform uint32)_Imm;
    if (count == 0) {
        return _A;
    }
    if (count >= 16) {
        uniform __m128i zero = {{0, 0, 0, 0}};
        return zero;
    }
    // SSE byte order places the least significant byte first in each 64-bit lane.
    const uniform uint64<2> lanes = @llvm.ispc.bitcast(_A.m128i_i32, (uniform uint64<2>)0);
    const uniform uint32 bits = (count & 7) * 8;
    uniform uint64<2> across = {lanes[1], 0};
    if (count >= 8) {
        across = across >> bits;
    } else {
        across = (lanes >> bits) | (across << (64 - bits));
    }
    return __mm_from_short_vector<uint64, 2>(across);
}

template <int Imm> inline unmasked constexpr uniform __m128i _mm_srli_si128(uniform __m128i _A) {
    return _mm_srli_si128(_A, Imm);
}

#define _mm_bsrli_si128 _mm_srli_si128

