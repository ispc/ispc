    const uniform uint16<8> packed = @llvm.ispc.bitcast(_A.m128i_i32, (uniform uint16<8>)0);
    const uniform uint64<2> count = @llvm.ispc.bitcast(_Count.m128i_i32, (uniform uint64<2>)0);
    const uniform uint16<8> result = count[0] > 15 ? (packed ? 0xFFFF : 0) : packed >> count[0];
    return __mm_from_short_vector<uint16, 8>(result);
}

