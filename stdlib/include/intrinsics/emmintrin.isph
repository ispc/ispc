/*
 * Integer, converts
 */

static inline unmasked constexpr uniform __m128i _mm_cvtsi32_si128(uniform int _A) {
    uniform __m128i result = {{_A, 0, 0, 0}};
    return result;
}

static inline unmasked constexpr uniform int _mm_cvtsi128_si32(uniform __m128i _A) { return _A.m128i_i32[0]; }

/*
 * Integer, misc
 */

static inline unmasked constexpr uniform __m128i _mm_packs_epi16(uniform __m128i _A, uniform __m128i _B) {
    const uniform int16<8> a = __mm_to_short_vector<int16, 8>(_A);
    const uniform int16<8> b = __mm_to_short_vector<int16, 8>(_B);
    const uniform int8<8> low = (uniform int8<8>)__mm_clamp_lanes<int16, 8>(a, INT8_MIN, INT8_MAX);
    const uniform int8<8> high = (uniform int8<8>)__mm_clamp_lanes<int16, 8>(b, INT8_MIN, INT8_MAX);
    const uniform int8<16> lanes = {low[0],  low[1],  low[2],  low[3],  low[4],  low[5],  low[6],  low[7],
                                    high[0], high[1], high[2], high[3], high[4], high[5], high[6], high[7]};
    return __mm_from_short_vector<int8, 16>(lanes);
}

static inline unmasked constexpr uniform __m128i _mm_packs_epi32(uniform __m128i _A, uniform __m128i _B) {
    const uniform int32<4> a = __mm_to_short_vector<int32, 4>(_A);
    const uniform int32<4> b = __mm_to_short_vector<int32, 4>(_B);
    // Keeping the upper half zero lets AVX-512 select the two-input packed instruction.
    const uniform int32<16> lanes = {a[0], a[1], a[2], a[3], b[0], b[1], b[2], b[3], 0, 0, 0, 0, 0, 0, 0, 0};
    const uniform int16<16> packed = (uniform int16<16>)__mm_clamp_lanes<int32, 16>(lanes, INT16_MIN, INT16_MAX);
    const uniform int16<8> result = {packed[0], packed[1], packed[2], packed[3],
                                     packed[4], packed[5], packed[6], packed[7]};
    return __mm_from_short_vector<int16, 8>(result);
}

static inline unmasked constexpr uniform __m128i _mm_packus_epi16(uniform __m128i _A, uniform __m128i _B) {
    const uniform int16<8> a = __mm_to_short_vector<int16, 8>(_A);
    const uniform int16<8> b = __mm_to_short_vector<int16, 8>(_B);
    // Repeat the inputs so LLVM can use a two-input pack for the low sixteen lanes.
    const uniform int16<32> lanes = {a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7], b[0], b[1], b[2],
                                     b[3], b[4], b[5], b[6], b[7], a[0], a[1], a[2], a[3], a[4], a[5],
                                     a[6], a[7], b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7]};
    const uniform uint8<32> packed = (uniform uint8<32>)__mm_clamp_lanes<int16, 32>(lanes, 0, UINT8_MAX);
    const uniform uint8<16> result = {packed[0],  packed[1],  packed[2],  packed[3], packed[4],  packed[5],
                                      packed[6],  packed[7],  packed[8],  packed[9], packed[10], packed[11],
                                      packed[12], packed[13], packed[14], packed[15]};
    return __mm_from_short_vector<uint8, 16>(result);
}

static inline unmasked constexpr uniform int _mm_extract_epi16(uniform __m128i _A, uniform int _Imm) {
    const uniform uint16<8> lanes = @llvm.ispc.bitcast(_A.m128i_i32, (uniform uint16<8>)0);
    return (uniform int)lanes[_Imm & 7];
}

template <int Imm> inline unmasked constexpr uniform int _mm_extract_epi16(uniform __m128i _A) {
    return _mm_extract_epi16(_A, Imm);
}

static inline unmasked constexpr uniform __m128i _mm_insert_epi16(uniform __m128i _A, uniform int _B,
                                                                  uniform int _Imm) {
    uniform int16<8> lanes = @llvm.ispc.bitcast(_A.m128i_i32, (uniform int16<8>)0);
    lanes[_Imm & 7] = (uniform int16)_B;
    return __mm_from_short_vector<int16, 8>(lanes);
}

template <int Imm> inline unmasked constexpr uniform __m128i _mm_insert_epi16(uniform __m128i _A, uniform int _B) {
    return _mm_insert_epi16(_A, _B, Imm);
}

static inline unmasked constexpr uniform int _mm_movemask_epi8(uniform __m128i _A) {
    const uniform int8<16> lanes = @llvm.ispc.bitcast(_A.m128i_i32, (uniform int8<16>)0);
    return __mm_movemask_lanes<16>(lanes < (uniform int8)0);
}

static inline unmasked constexpr uniform __m128i _mm_shuffle_epi32(uniform __m128i _A, uniform unsigned int _Imm8) {
    uniform __m128i result = {{_A.m128i_i32[_Imm8 & 3], _A.m128i_i32[(_Imm8 >> 2) & 3], _A.m128i_i32[(_Imm8 >> 4) & 3],
                               _A.m128i_i32[(_Imm8 >> 6) & 3]}};
    return result;
}

