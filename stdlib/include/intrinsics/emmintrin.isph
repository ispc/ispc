    const uniform int64<2> a = @llvm.ispc.bitcast(_A.m128i_i32, (uniform int64<2>)0);
    const uniform int64<2> b = @llvm.ispc.bitcast(_B.m128i_i32, (uniform int64<2>)0);
    const uniform int64<2> lanes = {a[1], b[1]};
