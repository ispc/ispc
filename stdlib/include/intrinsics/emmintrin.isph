    return _mm_shuffle_epi32(_A, Imm8);
}

static inline unmasked constexpr uniform __m128i _mm_shufflehi_epi16(uniform __m128i _A, uniform unsigned int _Imm8) {
    const uniform int16<8> src = @llvm.ispc.bitcast(_A.m128i_i32, (uniform int16<8>)0);
    uniform int16<8> result = src;
    result[4] = src[4 + (_Imm8 & 3)];
    result[5] = src[4 + ((_Imm8 >> 2) & 3)];
    result[6] = src[4 + ((_Imm8 >> 4) & 3)];
    result[7] = src[4 + ((_Imm8 >> 6) & 3)];
    return __mm_from_short_vector<int16, 8>(result);
}

template <int Imm8> inline unmasked constexpr uniform __m128i _mm_shufflehi_epi16(uniform __m128i _A) {
    const uniform int16<8> src = @llvm.ispc.bitcast(_A.m128i_i32, (uniform int16<8>)0);
    const uniform int16<8> dst = {src[0],
                                  src[1],
                                  src[2],
                                  src[3],
                                  src[4 + (Imm8 & 3)],
                                  src[4 + ((Imm8 >> 2) & 3)],
                                  src[4 + ((Imm8 >> 4) & 3)],
                                  src[4 + ((Imm8 >> 6) & 3)]};
    return __mm_from_short_vector<int16, 8>(dst);
}

static inline unmasked constexpr uniform __m128i _mm_shufflelo_epi16(uniform __m128i _A, uniform unsigned int _Imm8) {
    const uniform int16<8> src = @llvm.ispc.bitcast(_A.m128i_i32, (uniform int16<8>)0);
    uniform int16<8> result = src;
    result[0] = src[_Imm8 & 3];
    result[1] = src[(_Imm8 >> 2) & 3];
    result[2] = src[(_Imm8 >> 4) & 3];
    result[3] = src[(_Imm8 >> 6) & 3];
    return __mm_from_short_vector<int16, 8>(result);
}

