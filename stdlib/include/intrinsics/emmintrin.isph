static inline unmasked constexpr uniform __m128i _mm_srl_epi32(uniform __m128i _A, uniform __m128i _Count) {
    const uniform uint32<4> packed = @llvm.ispc.bitcast(_A.m128i_i32, (uniform uint32<4>)0);
    const uniform uint64<2> count = @llvm.ispc.bitcast(_Count.m128i_i32, (uniform uint64<2>)0);
    const uniform uint32<4> result = count[0] > 31 ? (packed ? 0xFFFFFFFF : 0) : packed >> count[0];
