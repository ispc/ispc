}

static inline unmasked constexpr uniform __m128i _mm_mulhi_epi16(uniform __m128i _A, uniform __m128i _B) {
    const uniform int16<8> a = __mm_to_short_vector<int16, 8>(_A);
    const uniform int16<8> b = __mm_to_short_vector<int16, 8>(_B);
    const uniform int32<8> product = (uniform int32<8>)a * (uniform int32<8>)b;
    return __mm_from_short_vector<int16, 8>((uniform int16<8>)(product >> 16));
}

static inline unmasked constexpr uniform __m128i _mm_mulhi_epu16(uniform __m128i _A, uniform __m128i _B) {
    const uniform uint16<8> a = __mm_to_short_vector<uint16, 8>(_A);
    const uniform uint16<8> b = __mm_to_short_vector<uint16, 8>(_B);
    const uniform uint32<8> product = (uniform uint32<8>)a * (uniform uint32<8>)b;
    return __mm_from_short_vector<uint16, 8>((uniform uint16<8>)(product >> 16));
}

static inline unmasked constexpr uniform __m128i _mm_mullo_epi16(uniform __m128i _A, uniform __m128i _B) {
    const uniform uint16<8> a = __mm_to_short_vector<uint16, 8>(_A);
    const uniform uint16<8> b = __mm_to_short_vector<uint16, 8>(_B);
    return __mm_from_short_vector<uint16, 8>(a * b);
}

#if defined(_M_IX86)
NOT_IMPLEMENTED(extern __m64 _mm_mul_su32(__m64 _A, __m64 _B));
#endif

static inline unmasked constexpr uniform __m128i _mm_mul_epu32(uniform __m128i _A, uniform __m128i _B) {
    const uniform uint64<2> a = __mm_to_short_vector<uint64, 2>(_A);
    const uniform uint64<2> b = __mm_to_short_vector<uint64, 2>(_B);
    // Preserve the existing selection of the first two adjacent lanes.
    const uniform uint32<2> low_a = @llvm.ispc.bitcast(a[0], (uniform uint32<2>)0);
    const uniform uint32<2> low_b = @llvm.ispc.bitcast(b[0], (uniform uint32<2>)0);
    return __mm_from_short_vector<uint64, 2>((uniform uint64<2>)low_a * (uniform uint64<2>)low_b);
}

static inline unmasked constexpr uniform __m128i _mm_sad_epu8(uniform __m128i _A, uniform __m128i _B) {
    const uniform uint8<16> a = __mm_to_short_vector<uint8, 16>(_A);
    const uniform uint8<16> b = __mm_to_short_vector<uint8, 16>(_B);
    const uniform bool<16> a_greater = a > b;
    const uniform uint8<16> hi = __mm_select_lanes<uint8, 16>(a_greater, a, b);
    const uniform uint8<16> lo = __mm_select_lanes<uint8, 16>(a_greater, b, a);
    const uniform uint8<16> differences = hi - lo;
    const uniform uint16<8> even = {differences[0], differences[2],  differences[4],  differences[6],
                                    differences[8], differences[10], differences[12], differences[14]};
    const uniform uint16<8> odd = {differences[1], differences[3],  differences[5],  differences[7],
                                   differences[9], differences[11], differences[13], differences[15]};
    const uniform uint16<8> pairs = even + odd;
    const uniform uint16<4> left = {pairs[0], pairs[2], pairs[4], pairs[6]};
    const uniform uint16<4> right = {pairs[1], pairs[3], pairs[5], pairs[7]};
    const uniform uint16<4> quarters = left + right;
    const uniform uint64<2> result = {quarters[0] + quarters[1], quarters[2] + quarters[3]};
    return __mm_from_short_vector<uint64, 2>(result);
}

