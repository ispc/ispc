}

static inline unmasked constexpr uniform __m128i _mm_avg_epu8(uniform __m128i _A, uniform __m128i _B) {
    const uniform uint8<16> a = __mm_to_short_vector<uint8, 16>(_A);
    const uniform uint8<16> b = __mm_to_short_vector<uint8, 16>(_B);
    const uniform uint16<16> sum = (uniform uint16<16>)a + (uniform uint16<16>)b + (uniform uint16)1;
    return __mm_from_short_vector<uint8, 16>((uniform uint8<16>)(sum >> 1));
}

static inline unmasked constexpr uniform __m128i _mm_avg_epu16(uniform __m128i _A, uniform __m128i _B) {
    const uniform uint16<8> a = __mm_to_short_vector<uint16, 8>(_A);
    const uniform uint16<8> b = __mm_to_short_vector<uint16, 8>(_B);
    const uniform uint32<8> sum = (uniform uint32<8>)a + (uniform uint32<8>)b + (uniform uint32)1;
    return __mm_from_short_vector<uint16, 8>((uniform uint16<8>)(sum >> 1));
}

static inline unmasked constexpr uniform __m128i _mm_madd_epi16(uniform __m128i _A, uniform __m128i _B) {
    const uniform int16<8> a = __mm_to_short_vector<int16, 8>(_A);
    const uniform int16<8> b = __mm_to_short_vector<int16, 8>(_B);
    const uniform int32<4> even_a = {a[0], a[2], a[4], a[6]};
    const uniform int32<4> odd_a = {a[1], a[3], a[5], a[7]};
    const uniform int32<4> even_b = {b[0], b[2], b[4], b[6]};
    const uniform int32<4> odd_b = {b[1], b[3], b[5], b[7]};
    const uniform uint32<4> even = (uniform uint32<4>)(even_a * even_b);
    const uniform uint32<4> odd = (uniform uint32<4>)(odd_a * odd_b);
    return __mm_from_short_vector<uint32, 4>(even + odd);
}

static inline unmasked constexpr uniform __m128i _mm_max_epi16(uniform __m128i _A, uniform __m128i _B) {
    const uniform int16<8> a = __mm_to_short_vector<int16, 8>(_A);
    const uniform int16<8> b = __mm_to_short_vector<int16, 8>(_B);
    return __mm_from_short_vector<int16, 8>(__mm_select_lanes<int16, 8>(a > b, a, b));
}

static inline unmasked constexpr uniform __m128i _mm_max_epu8(uniform __m128i _A, uniform __m128i _B) {
    const uniform uint8<16> a = __mm_to_short_vector<uint8, 16>(_A);
    const uniform uint8<16> b = __mm_to_short_vector<uint8, 16>(_B);
    return __mm_from_short_vector<uint8, 16>(__mm_select_lanes<uint8, 16>(a > b, a, b));
}

