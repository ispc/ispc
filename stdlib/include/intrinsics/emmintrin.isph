static inline unmasked uniform __m128d _mm_cmpneq_sd(uniform __m128d _A, uniform __m128d _B) {
    _A.m128d_f64[0] = _A.m128d_f64[0] != _B.m128d_f64[0] ? doublebits(0xFFFFFFFFFFFFFFFF) : 0.0d;
