static inline unmasked constexpr uniform __m128i _mm_unpacklo_epi16(uniform __m128i _A, uniform __m128i _B) {
    const uniform int16<8> a = __mm_to_short_vector<int16, 8>(_A);
    const uniform int16<8> b = __mm_to_short_vector<int16, 8>(_B);
    const uniform int16<8> lanes = {a[0], b[0], a[1], b[1], a[2], b[2], a[3], b[3]};
