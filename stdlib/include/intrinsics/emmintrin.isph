    const uniform int8<16> b = __mm_to_short_vector<int8, 16>(_B);
    const uniform int8<16> lanes = {a[8],  b[8],  a[9],  b[9],  a[10], b[10], a[11], b[11],
                                    a[12], b[12], a[13], b[13], a[14], b[14], a[15], b[15]};
