// @file amx.isph
// @brief Intel AMX (Advanced Matrix Extensions) functions.
//
// This header provides access to Intel AMX instructions for matrix operations.
// AMX is supported on different targets with varying feature sets:
//
//   Target      | amx-tile | amx-int8 | amx-bf16 | amx-fp16
//   ------------|----------|----------|----------|----------
//   avx512spr   |   Yes    |   Yes    |   Yes    |    No
//   avx512gnr   |   Yes    |   Yes    |   Yes    |   Yes
//   avx10.2dmr  |   Yes    |   Yes    |   Yes    |   Yes
//
// Using these functions on unsupported targets will result in a compile-time error.

#pragma once

#define EXT __attribute__((unmangled)) __attribute__((cdecl)) unmasked

// AMX Tile Configuration (amx-tile)
EXT void __amx_tile_loadconfig(const uniform int8 *uniform config);
EXT void __amx_tile_storeconfig(uniform int8 *uniform config);
EXT void __amx_tile_release();
EXT void __amx_tile_zero(uniform uint8 tile);
EXT void __amx_tile_load(uniform uint8 tile, const uniform int8 *uniform data, uniform int64 stride);
EXT void __amx_tile_load_t1(uniform uint8 tile, const uniform int8 *uniform data, uniform int64 stride);
EXT void __amx_tile_store(uniform uint8 tile, uniform int8 *uniform data, uniform int64 stride);

// AMX INT8 Dot Products (amx-int8)
EXT void __amx_dpbssd(uniform uint8 dst, uniform uint8 src1, uniform uint8 src2);
EXT void __amx_dpbsud(uniform uint8 dst, uniform uint8 src1, uniform uint8 src2);
EXT void __amx_dpbusd(uniform uint8 dst, uniform uint8 src1, uniform uint8 src2);
EXT void __amx_dpbuud(uniform uint8 dst, uniform uint8 src1, uniform uint8 src2);

// AMX FP16 Dot Product (amx-fp16)
EXT void __amx_dpfp16ps(uniform uint8 dst, uniform uint8 src1, uniform uint8 src2);

// AMX BF16 Dot Product (amx-bf16)
EXT void __amx_dpbf16ps(uniform uint8 dst, uniform uint8 src1, uniform uint8 src2);

///////////////////////////////////////////////////////////////////////////////
// AMX Tile Configuration and Control
///////////////////////////////////////////////////////////////////////////////

/// Load AMX tile configuration from memory.
/// @param config Pointer to 64-byte tile configuration structure.
inline void amx_tile_loadconfig(const uniform int8 *uniform config) { __amx_tile_loadconfig(config); }

/// Store AMX tile configuration to memory.
/// @param config Pointer to 64-byte tile configuration structure.
inline void amx_tile_storeconfig(uniform int8 *uniform config) { __amx_tile_storeconfig(config); }

/// Release AMX tile resources and set AMX state to INIT.
inline void amx_tile_release() { __amx_tile_release(); }

/// Zero an AMX tile.
/// @param tile Tile number (0-7).
inline void amx_tile_zero(uniform uint8 tile) { __amx_tile_zero(tile); }

/// Load data from memory into an AMX tile.
/// @param tile Tile number (0-7).
/// @param data Pointer to source data.
/// @param stride Stride in bytes between rows.
inline void amx_tile_load(uniform uint8 tile, const uniform int8 *uniform data, uniform int64 stride) {
    __amx_tile_load(tile, data, stride);
}

/// Load data from memory into an AMX tile with cache hint.
/// This provides a hint that the data will likely not be reused in the near
/// future and caching can be optimized accordingly.
/// @param tile Tile number (0-7).
/// @param data Pointer to source data.
/// @param stride Stride in bytes between rows.
inline void amx_tile_load_t1(uniform uint8 tile, const uniform int8 *uniform data, uniform int64 stride) {
    __amx_tile_load_t1(tile, data, stride);
}

/// Store an AMX tile to memory.
/// @param tile Tile number (0-7).
/// @param data Pointer to destination data.
/// @param stride Stride in bytes between rows.
inline void amx_tile_store(uniform uint8 tile, uniform int8 *uniform data, uniform int64 stride) {
    __amx_tile_store(tile, data, stride);
}

/// Named AMX tile IDs for constexpr/template use.
/// `static` avoids linkage conflicts when included from multiple translation units.
static constexpr uniform int amx_tmm0 = 0;
static constexpr uniform int amx_tmm1 = 1;
static constexpr uniform int amx_tmm2 = 2;
static constexpr uniform int amx_tmm3 = 3;
static constexpr uniform int amx_tmm4 = 4;
static constexpr uniform int amx_tmm5 = 5;
static constexpr uniform int amx_tmm6 = 6;
static constexpr uniform int amx_tmm7 = 7;

///////////////////////////////////////////////////////////////////////////////
// AMX template wrappers for compile-time tile IDs
///////////////////////////////////////////////////////////////////////////////

// Validate the full tile index before converting it to the intrinsic's i8 operand.
static constexpr uniform int8 __amx_checked_tile_id(uniform uint64 tile) {
    constexpr uniform int8 tileIds[8] = {amx_tmm0, amx_tmm1, amx_tmm2, amx_tmm3,
                                         amx_tmm4, amx_tmm5, amx_tmm6, amx_tmm7};
    // Use a one-past-end index for invalid IDs even with 32-bit addressing.
    return tileIds[tile < 8 ? (uniform int)tile : 8];
}

template <uint64 Tile> inline void amx_tile_zero() { @llvm.x86.tilezero(__amx_checked_tile_id(Tile)); }

template <uint64 Tile> inline void amx_tile_load(const uniform int8 *uniform data, uniform int64 stride) {
    @llvm.x86.tileloadd64(__amx_checked_tile_id(Tile), (uniform int8 * uniform) data, stride);
}

template <uint64 Tile> inline void amx_tile_load_t1(const uniform int8 *uniform data, uniform int64 stride) {
    @llvm.x86.tileloaddt164(__amx_checked_tile_id(Tile), (uniform int8 * uniform) data, stride);
}

template <uint64 Tile> inline void amx_tile_store(uniform int8 *uniform data, uniform int64 stride) {
    @llvm.x86.tilestored64(__amx_checked_tile_id(Tile), data, stride);
}

///////////////////////////////////////////////////////////////////////////////
// AMX INT8 Dot Products (requires amx-int8)
///////////////////////////////////////////////////////////////////////////////

/// INT8 dot product: dst += src1 (signed int8) x src2 (signed int8).
/// @param dst Destination tile number (0-7).
/// @param src1 Source tile 1 number (0-7).
/// @param src2 Source tile 2 number (0-7).
inline void amx_dpbssd(uniform uint8 dst, uniform uint8 src1, uniform uint8 src2) { __amx_dpbssd(dst, src1, src2); }

/// INT8 dot product: dst += src1 (signed int8) x src2 (unsigned int8).
/// @param dst Destination tile number (0-7).
/// @param src1 Source tile 1 number (0-7).
/// @param src2 Source tile 2 number (0-7).
inline void amx_dpbsud(uniform uint8 dst, uniform uint8 src1, uniform uint8 src2) { __amx_dpbsud(dst, src1, src2); }

/// INT8 dot product: dst += src1 (unsigned int8) x src2 (signed int8).
/// @param dst Destination tile number (0-7).
/// @param src1 Source tile 1 number (0-7).
/// @param src2 Source tile 2 number (0-7).
inline void amx_dpbusd(uniform uint8 dst, uniform uint8 src1, uniform uint8 src2) { __amx_dpbusd(dst, src1, src2); }

/// INT8 dot product: dst += src1 (unsigned int8) x src2 (unsigned int8).
/// @param dst Destination tile number (0-7).
/// @param src1 Source tile 1 number (0-7).
/// @param src2 Source tile 2 number (0-7).
inline void amx_dpbuud(uniform uint8 dst, uniform uint8 src1, uniform uint8 src2) { __amx_dpbuud(dst, src1, src2); }

template <uint64 DstTile, uint64 Src1Tile, uint64 Src2Tile> inline void amx_dpbssd() {
    @llvm.x86.tdpbssd(__amx_checked_tile_id(DstTile), __amx_checked_tile_id(Src1Tile), __amx_checked_tile_id(Src2Tile));
}

template <uint64 DstTile, uint64 Src1Tile, uint64 Src2Tile> inline void amx_dpbsud() {
    @llvm.x86.tdpbsud(__amx_checked_tile_id(DstTile), __amx_checked_tile_id(Src1Tile), __amx_checked_tile_id(Src2Tile));
}

template <uint64 DstTile, uint64 Src1Tile, uint64 Src2Tile> inline void amx_dpbusd() {
    @llvm.x86.tdpbusd(__amx_checked_tile_id(DstTile), __amx_checked_tile_id(Src1Tile), __amx_checked_tile_id(Src2Tile));
}

template <uint64 DstTile, uint64 Src1Tile, uint64 Src2Tile> inline void amx_dpbuud() {
    @llvm.x86.tdpbuud(__amx_checked_tile_id(DstTile), __amx_checked_tile_id(Src1Tile), __amx_checked_tile_id(Src2Tile));
}

///////////////////////////////////////////////////////////////////////////////
// AMX FP16 Dot Product (requires amx-fp16)
///////////////////////////////////////////////////////////////////////////////

/// FP16 dot product: dst += src1 (float16) x src2 (float16).
/// @param dst Destination tile number (0-7).
/// @param src1 Source tile 1 number (0-7).
/// @param src2 Source tile 2 number (0-7).
inline void amx_dpfp16ps(uniform uint8 dst, uniform uint8 src1, uniform uint8 src2) { __amx_dpfp16ps(dst, src1, src2); }

template <uint64 DstTile, uint64 Src1Tile, uint64 Src2Tile> inline void amx_dpfp16ps() {
    @llvm.x86.tdpfp16ps(__amx_checked_tile_id(DstTile), __amx_checked_tile_id(Src1Tile),
                        __amx_checked_tile_id(Src2Tile));
}

///////////////////////////////////////////////////////////////////////////////
// AMX BF16 Dot Product (requires amx-bf16)
///////////////////////////////////////////////////////////////////////////////

/// BF16 dot product: dst += src1 (bf16) x src2 (bf16).
/// @param dst Destination tile number (0-7).
/// @param src1 Source tile 1 number (0-7).
/// @param src2 Source tile 2 number (0-7).
inline void amx_dpbf16ps(uniform uint8 dst, uniform uint8 src1, uniform uint8 src2) { __amx_dpbf16ps(dst, src1, src2); }

template <uint64 DstTile, uint64 Src1Tile, uint64 Src2Tile> inline void amx_dpbf16ps() {
    @llvm.x86.tdpbf16ps(__amx_checked_tile_id(DstTile), __amx_checked_tile_id(Src1Tile),
                        __amx_checked_tile_id(Src2Tile));
}

#undef EXT
